# ==============================================================================
# Wedding Goosebumps CMS - Environment Configuration Template
# Copy this file to frontend/.env and fill in the values below:
# cp .env.example frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM with MySQL)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="your-super-secret-nextauth-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL CONFIGURATION (Backend Email Dispatch & Leads Notifications)
# ------------------------------------------------------------------------------
# If left blank, the application will automatically run in "Simulation Mode":
# emails will be safely logged to the console & activity audit log without crashing.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false

# (Note: For Gmail, use a 16-character Google App Password: myaccount.google.com/apppasswords)
SMTP_USER="weddinggoosebumps@gmail.com"
SMTP_PASS="your-16-character-app-password"

SMTP_FROM="Wedding Goosebumps <weddinggoosebumps@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="weddinggoosebumps@gmail.com"
